# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atlas_pim
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif

# Image Optimization
IMAGE_QUALITY=80
IMAGE_MAX_WIDTH=2000
IMAGE_MAX_HEIGHT=2000
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=300

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Prestashop Integration
PRESTASHOP_API_URL=http://localhost:8080/api
PRESTASHOP_API_KEY=your_prestashop_api_key_here

# Icecat Integration
ICECAT_USERNAME=your_icecat_username_here
ICECAT_PASSWORD=your_icecat_password_here
ICECAT_LANGUAGE=en

# CVA API Integration (Proveedor)
CVA_API_URL=https://apicvaservices.grupocva.com
ENCRYPTION_KEY=your-32-character-encryption-key-here-change-this

# CVA credentials se configuran via API POST /api/v1/cva/config
# No es necesario agregarlas aquí, se guardan encriptadas en la base de datos

# AI Curation
# Las credenciales de IA (Claude API key, LM Studio endpoint) se configuran via API
# POST /api/v1/ai/config - Se guardan encriptadas en la base de datos
# Solo se necesita la ENCRYPTION_KEY (ya definida arriba)
