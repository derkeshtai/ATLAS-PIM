# ATLAS PIM - Docker Compose Environment Variables

# Node Environment
NODE_ENV=production

# Server Configuration
PORT=3000

# Database Configuration
DB_NAME=atlas_pim
DB_USER=postgres
DB_PASSWORD=change_this_password_in_production
DB_PORT=5432

# JWT Configuration
JWT_SECRET=change-this-secret-key-to-something-very-secure-in-production
JWT_EXPIRES_IN=7d

# Upload Configuration
MAX_FILE_SIZE=10485760

# Image Processing
IMAGE_QUALITY=80
IMAGE_MAX_WIDTH=2000
IMAGE_MAX_HEIGHT=2000
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=300

# CORS
CORS_ORIGIN=*
